{
  "$schema": "https://json.schemastore.org/prettierrc",
  "singleQuote": true,
  "jsxSingleQuote": false,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "trailingComma": "all",
  "quoteProps": "preserve",
  "endOfLine": "auto",
  "printWidth": 120,
  "overrides": [
    {
      "files": "*.tsx",
      "options": {
        "printWidth": 1000
      }
    }
  ]
}